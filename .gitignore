# deploy_v2: dados brutos de exemplo (pesados) e saídas de inferência geradas ao rodar.
# Os bundles (model_state.pt/scaler.pkl/*.json), o módulo, scripts e README SÃO versionados.
deploy_v2/Transpetro/*/dados/
deploy_v2/Transpetro/*/scripts/*_inferencia.csv
# exceção à regra global "*.pt": os pesos do bundle de deploy DEVEM ser versionados
!deploy_v2/Transpetro/*/modelos/*/model_state.pt
